<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold mb-0">Movie Lists</h1>
  </div>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <% @lists.each do |list| %>
      <div class="col">
        <div class="card border-0 shadow h-100 overflow-hidden">
          <% if list.photo.attached? %>
            <%= cl_image_tag list.photo.key,
                crop: :fill,
                class: "card-img-top w-100 object-fit-cover",
                style: "height: 220px; object-position: top;" %>
          <% else %>
            <div class="bg-body-secondary d-flex align-items-center justify-content-center text-body-tertiary"
                 style="height: 220px;">
              <span class="small fw-light">No cover image</span>
            </div>
          <% end %>
          <div class="card-body p-3 d-flex align-items-center justify-content-between">
            <h5 class="card-title fw-bold mb-0">
              <%= link_to list.name, list_path(list), class: "text-decoration-none text-body stretched-link" %>
            </h5>
            <span class="text-body-tertiary small">&rarr;</span>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>