<div class="container p-4">
  <div class="d-flex justify-content-between">
    <h1>Movie Lists</h1>
    <%= link_to "Create a movie list", new_list_path %>
  </div>
  <ul class="list-group">
    <% @lists.each do |list| %>
      <li class="list-group-item">
        <%= link_to list.name, list_path(list), class: "text-decoration-none" %>
      </li>
    <% end %>
  </ul>
</div>