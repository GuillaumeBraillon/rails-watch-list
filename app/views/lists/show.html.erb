<% banner_bg = if @list.photo.attached?
     "linear-gradient(rgba(15, 23, 42, 0.55), rgba(15, 23, 42, 0.72)), url('#{cl_image_path(@list.photo.key, crop: :fill)}')"
   else
     "linear-gradient(135deg, #1e293b, #0f172a)"
   end %>
<div class="rounded-3 p-4 p-md-5 mb-4 text-white shadow"
     style="background-image: <%= banner_bg %>; background-size: cover; background-position: center top; min-height: 200px;">
  <div class="d-flex justify-content-between align-items-start gap-3">
    <div>
      <h1 class="fw-bold mb-1"><%= @list.name %></h1>
      <p class="fw-light text-white-50 small mb-0">Nombre de films : <%= @movies.count %></p>
    </div>
    <%= link_to "Return", lists_path, class: "btn btn-light btn-sm text-decoration-none flex-shrink-0" %>
  </div>
</div>
<div class="container px-4 pb-5">
  <div class="row g-4 align-items-start">
    <%# Colonne gauche : films de la liste %>
    <div class="col-12 col-lg-8">
      <div class="row g-4">
        <% @bookmarks.each do |bookmark| %>
          <div class="col-12 col-sm-6">
            <div class="card h-100 p-0 overflow-hidden border-0 shadow">
              <%= image_tag bookmark.movie.poster_url,
                  alt: bookmark.movie.title,
                  class: "card-img-top w-100",
                  style: "height: 220px; object-fit: cover; object-position: top;" %>
              <div class="card-body p-3 d-flex flex-column">
                <h5 class="card-title fw-bold"><%= bookmark.movie.title %></h5>
                <p class="card-text fw-light text-body-tertiary"><%= bookmark.movie.overview %></p>
                <div class="d-flex justify-content-between align-items-baseline gap-2 mt-auto pt-2">
                  <% if bookmark.comment.present? %>
                    <figcaption class="blockquote-footer fst-italic text-body mb-0">
                      "<%= bookmark.comment %>"
                    </figcaption>
                  <% else %>
                    <span></span>
                  <% end %>
                  <%= link_to "Delete",
                      bookmark_path(bookmark),
                      data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                      class: "text-danger text-decoration-none small flex-shrink-0" %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    <%# Colonne droite : liste des reviews en haut, puis formulaires %>
    <div class="col-12 col-lg-4 d-flex flex-column gap-4">
      <%# Liste des reviews %>
      <div>
        <div class="d-flex justify-content-between align-items-baseline mb-3">
          <h5 class="fw-bold mb-0">Reviews</h5>
          <span class="fw-light text-body-tertiary small"><%= @list.reviews.size %> avis</span>
        </div>
        <% if @list.reviews.any? %>
          <div class="d-flex flex-column gap-3">
            <% @list.reviews.each do |review| %>
              <div class="card border-0 shadow-sm">
                <div class="card-body p-3 d-flex justify-content-between align-items-start gap-3">
                  <div>
                    <p class="fw-bold small mb-1"><%= review.name %></p>
                    <p class="fw-light text-body-tertiary small mb-0"><%= review.content %></p>
                  </div>
                  <%= link_to "Delete",
                      review_path(review),
                      data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                      class: "text-danger text-decoration-none small flex-shrink-0" %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="card border-0 shadow-sm">
            <div class="card-body p-3 text-center fw-light text-body-tertiary small">
              Aucun avis pour cette liste pour le moment.
            </div>
          </div>
        <% end %>
      </div>
      <%# Formulaire ajout de film %>
      <div class="card border-0 shadow">
        <div class="card-body p-4">
          <h5 class="card-title fw-bold mb-3">Add a movie to the list</h5>
          <%= simple_form_for [@list, @bookmark] do |f| %>
            <%= f.association :movie,
                collection: Movie.order(:title),
                prompt: "Choose a movie...",
                label_html: { class: "fw-light text-body-tertiary small" } %>
            <%= f.input :comment,
                placeholder: "Your review on the movie...",
                label_html: { class: "fw-light text-body-tertiary small" } %>
            <div class="d-flex justify-content-end mt-3">
              <%= f.button :submit, "Add the movie", class: "btn btn-dark btn-sm px-3" %>
            </div>
          <% end %>
        </div>
      </div>
      <%# Formulaire ajout d'avis %>
      <div class="card border-0 shadow">
        <div class="card-body p-4">
          <h5 class="card-title fw-bold mb-3">Add a review to the list</h5>
          <%= simple_form_for [@list, @review] do |f| %>
            <%= f.input :name,
                placeholder: "Enter your name...",
                label_html: { class: "fw-light text-body-tertiary small" } %>
            <%= f.input :content,
                placeholder: "Your review on the list...",
                label_html: { class: "fw-light text-body-tertiary small" } %>
            <div class="d-flex justify-content-end mt-3">
              <%= f.button :submit, "Add a review", class: "btn btn-dark btn-sm px-3" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>